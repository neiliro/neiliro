# Copy to .env and adjust. Every variable is optional unless marked otherwise;
# defaults are shown. Compose reads this file automatically.

# ── Common ──────────────────────────────────────────────────────────────────

# Container timezone. The hub uses local wall-clock time everywhere
# ("today", recurring items, budgets), so set this to YOUR timezone.
TZ=UTC

# debug | info | warn | error | silent
#LOG_LEVEL=warn

# ── Home setup (docker-compose.yml) ─────────────────────────────────────────

# Host port the hub is published on.
#PORT=8787

# Set to true only after HTTPS works (scripts/setup-https.sh),
# otherwise the browser rejects the session cookie and sign-in breaks.
#SECURE_COOKIES=false

# Network name for local HTTPS. Must match the machine's Bonjour name —
# see scripts/setup-https.sh, it sets this for you.
#HUB_HOST=hub.local

# ── Production (docker-compose.prod.yml) ────────────────────────────────────

# REQUIRED in production: the domain the hub is served on.
# Caddy obtains a Let's Encrypt certificate for it automatically.
#HUB_DOMAIN=hub.example.com

# Where the hub's data lives on the server (owned by uid 1000).
#DATA_DIR=/srv/family-hub/data

# Public key for encrypted backups (scripts/backup.sh). Required by the
# script: without it the run stops before pushing anything and reports
# failure to BACKUP_PING_URL (the plain tar.gz it made stays in
# DATA_DIR/backups — delete it).
#AGE_RECIPIENT=age1...
# Optional: a git clone mounted into the container; when set, the script
# commits and pushes each archive there.
#BACKUP_REPO_DIR=/backup-repo
# How many daily backup sets stay on this disk (default 14). A hosted
# server that ships every set off-site keeps 2.
#BACKUP_KEEP_DAYS=14
# Off-site copy of each day's archives to an S3-compatible bucket (hosted;
# Cloudflare R2 in production). rclone reads the remote from these; the
# bucket's own lifecycle rule is the retention there. A failed upload fails
# the run and the dead-man switch reports it.
#BACKUP_R2_BUCKET=neiliro-backups
#RCLONE_CONFIG_R2_TYPE=s3
#RCLONE_CONFIG_R2_PROVIDER=Cloudflare
#RCLONE_CONFIG_R2_ENDPOINT=https://<account-id>.eu.r2.cloudflarestorage.com
#RCLONE_CONFIG_R2_ACCESS_KEY_ID=...
#RCLONE_CONFIG_R2_SECRET_ACCESS_KEY=...

# Dead-man switch for the nightly backup (optional): a healthchecks.io-style
# ping URL. The backup script hits it on success and <url>/fail on failure,
# so a backup that silently stops running raises an alarm.
#BACKUP_PING_URL=https://hc-ping.com/your-uuid

# Google sign-in (optional). Both values come from Google Cloud Console
# (OAuth client, Web application). Empty values disable the feature.
#GOOGLE_CLIENT_ID=1234567890-abc.apps.googleusercontent.com
#GOOGLE_CLIENT_SECRET=GOCSPX-...

# ── Public demo (docker-compose.demo.yml overlay) ───────────────────────────

# Domain for the public demo sandbox (needs a DNS A record).
#DEMO_DOMAIN=demo.example.com
# Read by .github/workflows/deploy.yml on the server, not by the app: set to
# false on a machine that runs only the demo, so the deploy does not start
# (or resurrect) the family hub container next to it.
#HUB_ENABLED=false

# Where the throwaway demo data lives.
#DEMO_DATA_DIR=/srv/family-hub/demo-data

# ── Hosted mode (multi-family, one server) ──────────────────────────────────

# Many families on one server, one database file each, routed by subdomain.
# Not needed for self-hosting a single family — leave both unset.
# See docs/architecture.md, "Hosted mode".
# Everything in this section (and the mail, sign-up and billing variables
# below) is passed to the container by the control plane's compose file in
# neiliro/cloud; the compose files in this repository do not forward them,
# so setting them here on a self-hosted install does nothing.
#HOSTED_MODE=true
#HOSTED_DOMAIN=example.com
# Which node of the service this machine is (ADR 0002: gateway, control,
# shards). Names the registry archive and the route map; a family's own
# row never carries the local name (it is NULL here, on every node), so
# renaming a node is a matter of this line and nothing in the registry.
# One machine plays every role today — leave the default.
#NODE_NAME=hosted01

# Family mail on the service's own domain. Each family's address is
# <slug>@<MAIL_DOMAIN>, derived from the subdomain — nothing to configure
# per family. Inbound arrives as a Mailgun route forwarding to
#   https://in.<apex>/api/mail/inbound/mime
# The URL MUST end in "mime": that is what makes Mailgun send the raw
# message instead of its own parsed fields.
# The signing key is Mailgun's HTTP webhook signing key (Settings -> API
# Security), NOT the sending API key. Nothing is accepted unsigned, so the
# two variables are all-or-nothing — the hub refuses to start with one.
#MAIL_DOMAIN=mail.example.com
#MAILGUN_SIGNING_KEY=...

# Sending, for a family with no mailbox of its own. This is Mailgun's
# HTTP API and not SMTP on purpose: cloud providers block outbound SMTP
# (DigitalOcean closes 25/465/587 by default), so port 443 is the only
# one that can be relied on. Replies go out as the family's own address;
# this key only identifies the service to Mailgun.
# The API key is the sending key (Settings -> API Keys), which is NOT the
# webhook signing key above.
#MAILGUN_API_KEY=...
# Regional endpoint — a domain belongs to exactly one cloud.
# Default: https://api.eu.mailgun.net (use https://api.mailgun.net for US)
#MAILGUN_API_BASE=https://api.eu.mailgun.net

# Self-serve sign-up (hosted only). The landing page's form is forwarded
# to signup.<HOSTED_DOMAIN>/api/signup with this bearer token; both sides
# read it from env. Empty = the route does not exist. Needs service mail
# above: every sign-up is one letter to the family's founder.
#SIGNUP_TOKEN=...
# Process-wide ceiling on sign-ups per hour (default 60) — a flood is a
# deliverability problem before it is a disk problem.
#SIGNUP_HOURLY_CAP=60

# Billing through Paddle (hosted only). Paddle is the merchant of record:
# it sells the subscription, holds the card and issues the receipt; the
# hub only learns what happened through signed webhooks on
# billing.<HOSTED_DOMAIN>/api/billing/paddle. Empty secret = no route,
# and every family stays on its 30-day trial clock (then read-only).
#PADDLE_WEBHOOK_SECRET=pdl_ntfset_...
# Server-side API key, used only to mint the customer-portal link.
#PADDLE_API_KEY=pdl_live_apikey_...
# sandbox | live — separate Paddle accounts, keys and API hosts.
#PADDLE_ENV=sandbox

# A pending change to the terms or the privacy policy (hosted only). While
# both are set, every family administrator sees a dismissable notice in the
# hub naming the date and linking to what changes; the e-mail half of the
# promise is the operator's script in neiliro/cloud. Set together or not at
# all; the URL must be https, the date a real YYYY-MM-DD. Unset both once
# the date has passed.
#POLICY_NOTICE_URL=https://example.com/privacy#changes
#POLICY_NOTICE_EFFECTIVE=2026-10-15
