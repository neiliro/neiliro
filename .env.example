# Copy to .env and adjust. Every variable is optional unless marked otherwise;
# defaults are shown. Compose reads this file automatically.

# ── Common ──────────────────────────────────────────────────────────────────

# Container timezone. The hub uses local wall-clock time everywhere
# ("today", recurring items, budgets), so set this to YOUR timezone.
TZ=UTC

# debug | info | warn | error | silent
#LOG_LEVEL=warn

# ── Home setup (docker-compose.yml) ─────────────────────────────────────────

# Host port the hub is published on.
#PORT=8787

# Set to true only after HTTPS works (scripts/setup-https.sh),
# otherwise the browser rejects the session cookie and sign-in breaks.
#SECURE_COOKIES=false

# Network name for local HTTPS. Must match the machine's Bonjour name —
# see scripts/setup-https.sh, it sets this for you.
#HUB_HOST=hub.local

# ── Production (docker-compose.prod.yml) ────────────────────────────────────

# REQUIRED in production: the domain the hub is served on.
# Caddy obtains a Let's Encrypt certificate for it automatically.
#HUB_DOMAIN=hub.example.com

# Where the hub's data lives on the server (owned by uid 1000).
#DATA_DIR=/srv/family-hub/data

# Public key for encrypted backups (scripts/backup.sh). Empty disables
# pushing backups; unencrypted archives are never pushed.
#AGE_RECIPIENT=age1...

# Dead-man switch for the nightly backup (optional): a healthchecks.io-style
# ping URL. The backup script hits it on success and <url>/fail on failure,
# so a backup that silently stops running raises an alarm.
#BACKUP_PING_URL=https://hc-ping.com/your-uuid

# Google sign-in (optional). Both values come from Google Cloud Console
# (OAuth client, Web application). Empty values disable the feature.
#GOOGLE_CLIENT_ID=1234567890-abc.apps.googleusercontent.com
#GOOGLE_CLIENT_SECRET=GOCSPX-...

# ── Public demo (docker-compose.demo.yml overlay) ───────────────────────────

# Domain for the public demo sandbox (needs a DNS A record).
#DEMO_DOMAIN=demo.example.com

# Where the throwaway demo data lives.
#DEMO_DATA_DIR=/srv/family-hub/demo-data

# ── Hosted mode (multi-family, one server) ──────────────────────────────────

# Many families on one server, one database file each, routed by subdomain.
# Not needed for self-hosting a single family — leave both unset.
# See docs/architecture.md, "Hosted mode".
#HOSTED_MODE=true
#HOSTED_DOMAIN=example.com

# Family mail on the service's own domain. Each family's address is
# <slug>@<MAIL_DOMAIN>, derived from the subdomain — nothing to configure
# per family. Inbound arrives as a Mailgun route forwarding to
#   https://in.<apex>/api/mail/inbound/mime
# The URL MUST end in "mime": that is what makes Mailgun send the raw
# message instead of its own parsed fields.
# The signing key is Mailgun's HTTP webhook signing key (Settings -> API
# Security), NOT the sending API key. Nothing is accepted unsigned, so the
# two variables are all-or-nothing — the hub refuses to start with one.
#MAIL_DOMAIN=mail.example.com
#MAILGUN_SIGNING_KEY=...

# SMTP of that domain, so a family with no mailbox of its own can reply.
# Replies go out as the family's address; this user is only how the hub
# authenticates to the relay.
#MAIL_SMTP_HOST=smtp.eu.mailgun.org
#MAIL_SMTP_PORT=465
#MAIL_SMTP_USER=postmaster@mail.example.com
#MAIL_SMTP_PASS=...
