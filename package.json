{
  "name": "neiliro",
  "private": true,
  "license": "AGPL-3.0-only",
  "version": "1.2.0",
  "type": "module",
  "workspaces": [
    "server",
    "web"
  ],
  "scripts": {
    "dev": "concurrently -n server,web -c blue,magenta \"npm:dev --workspace=server\" \"npm:dev --workspace=web\"",
    "build": "npm run build --workspace=web && npm run build --workspace=server",
    "start": "npm run start --workspace=server",
    "typecheck": "npm run typecheck --workspace=server && npm run typecheck --workspace=web",
    "export": "node scripts/export.mjs",
    "import": "node scripts/import.mjs",
    "admin:reset": "node scripts/admin-reset.mjs",
    "screenshots": "node scripts/screenshots.mjs",
    "test": "npm run test --workspace=server && npm run test --workspace=web",
    "lint": "eslint server/src web/src scripts"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "typescript-eslint": "^8.67.0",
    "vitest": "^3.2.7"
  }
}
